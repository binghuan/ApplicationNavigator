# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk.dir is not tracked)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
# Android Studio 3 and later
.idea/caches/build_file_checksums.ser
.idea/modules.xml

# Keystore files
*.jks
*.keystore
*.pem
*.p12
*.key

# External native build folder
.cxx/
.externalNativeBuild/

# Google Services (e.g. APIs or Firebase)
google-services.json

# OS specific
.DS_Store
Thumbs.db
